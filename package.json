{
  "name": "osteopathie-animale-bordeaux",
  "type": "module",
  "private": true,
  "description": "Site Astro propulsant l'ostéopathie animale d'Agathe Lescout",
  "version": "0.4.0",
  "author": "Kostas Vrouvas <hello@kosvrouvas.com>",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mjs,css,astro,yml,yaml}\" \".prettierrc\" \".lighthouserc*.json\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"ci/**/*.json\" \"*.{js,mjs,ts,json}\" \".prettierrc\" \".lighthouserc*.json\" \".github/**/*.{yml,yaml}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts}\" --fix --max-warnings 0",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tests.json",
    "check:static": "yarn format:check && yarn lint && yarn typecheck",
    "test:unit": "node --test scripts/*.test.js tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:netlify": "playwright test --config=playwright.netlify.config.ts",
    "test": "yarn test:e2e",
    "lighthouse:remote": "lhci collect --config=.lighthouserc.remote.json --url=${LIGHTHOUSE_TARGET_URL}",
    "ci:lighthouse:regression": "node scripts/check-lighthouse-regression.mjs"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@react-aria/button": "^3.15.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/listbox": "^3.16.1",
    "@react-aria/menu": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/select": "^3.18.1",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/collections": "^3.13.1",
    "@react-stately/select": "^3.10.1",
    "@react-stately/tree": "^3.10.1",
    "@sentry/astro": "^11.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "mapbox-gl": "^3.32.0",
    "posthog-js": "1.435.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-modal": "^3.16.3",
    "smoothscroll-polyfill": "0.4.4",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro": "^7.3.5",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.2"
  },
  "resolutions": {
    "baseline-browser-mapping": "2.11.27",
    "protocol-buffers-schema": "3.6.1"
  },
  "packageManager": "yarn@1.22.22"
}
