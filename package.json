{
  "name": "osteopathie-animale",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "yarn workspace @osteo/website dev",
    "start": "yarn workspace @osteo/website start",
    "build": "yarn workspace @osteo/website build",
    "preview": "yarn workspace @osteo/website preview",
    "lint": "yarn workspace @osteo/website lint",
    "typecheck": "yarn workspace @osteo/website typecheck",
    "test:unit": "yarn workspace @osteo/website test:unit && yarn workspace @osteo/backoffice test",
    "test:e2e": "yarn workspace @osteo/website test:e2e",
    "test:e2e:netlify": "yarn workspace @osteo/website test:e2e:netlify",
    "lighthouse:remote": "yarn workspace @osteo/website lighthouse:remote",
    "ci:lighthouse:regression": "yarn workspace @osteo/website ci:lighthouse:regression",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn workspace @osteo/contacts-sync run check && yarn workspace @osteo/backoffice run check",
    "check:static": "yarn run check",
    "test": "yarn workspace @osteo/website test && yarn workspace @osteo/contacts-sync test && yarn workspace @osteo/backoffice test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,jsonc,md,mjs,css,astro,yml,yaml}\" .prettierrc",
    "format:check": "prettier --check package.json .prettierrc \".github/**/*.{yml,yaml}\" README.md && yarn workspace @osteo/website format:check",
    "dev:sync": "yarn workspace @osteo/contacts-sync dev",
    "build:sync": "yarn workspace @osteo/contacts-sync build",
    "sync:admin": "yarn workspace @osteo/contacts-sync admin",
    "dev:backoffice": "yarn workspace @osteo/backoffice dev",
    "preview:backoffice": "yarn workspace @osteo/backoffice preview",
    "preview:pull:backoffice": "yarn workspace @osteo/backoffice preview:pull",
    "preview:export:backoffice": "yarn workspace @osteo/backoffice preview:export",
    "build:backoffice": "yarn workspace @osteo/backoffice build",
    "backoffice:configure": "yarn workspace @osteo/backoffice configure",
    "backoffice:access": "yarn workspace @osteo/backoffice access:check"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  },
  "resolutions": {
    "baseline-browser-mapping": "2.11.27",
    "protocol-buffers-schema": "3.6.1",
    "sharp": "0.35.4"
  }
}
