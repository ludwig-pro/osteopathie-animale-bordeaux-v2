{
  "name": "@osteo/website",
  "type": "module",
  "private": true,
  "description": "Site Astro propulsant l'ostéopathie animale d'Agathe Lescout",
  "version": "0.4.0",
  "author": "Kostas Vrouvas <hello@kosvrouvas.com>",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mjs,css,astro}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"ci/**/*.json\" \"*.{js,mjs,ts,json}\" \".lighthouserc*.json\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" \"tests/**/*.{js,ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts}\" --fix --max-warnings 0",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tests.json",
    "check:static": "yarn format:check && yarn lint && yarn typecheck",
    "test:unit": "node --test scripts/*.test.js tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:netlify": "playwright test --config=playwright.netlify.config.ts",
    "test": "yarn test:unit && yarn test:e2e",
    "lighthouse:remote": "lhci collect --config=.lighthouserc.remote.json --url=${LIGHTHOUSE_TARGET_URL}",
    "ci:lighthouse:regression": "node scripts/check-lighthouse-regression.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@heroicons/react": "2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/astro": "^11.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "1.9.4",
    "posthog-js": "1.435.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "smoothscroll-polyfill": "0.4.4",
    "tailwind-merge": "^3.7.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro": "^7.3.5",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.2"
  }
}
