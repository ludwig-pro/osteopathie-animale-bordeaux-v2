{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "osteo-backoffice-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:8788",
    "ACCESS_TEAM_DOMAIN": "configure-before-use",
    "ACCESS_AUD": "configure-before-use",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osteo-backoffice-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "osteo-backoffice-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        {
          "binding": "GOOGLE_CONTACTS",
          "service": "osteo-contacts-sync-staging",
          "entrypoint": "GoogleContactsService",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "osteo-backoffice-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://backoffice-staging.osteopathie-animale-bordeaux.fr",
        "ACCESS_TEAM_DOMAIN": "configure-before-use",
        "ACCESS_AUD": "configure-before-use",
      },
    },
    "production": {
      "name": "osteo-backoffice",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        {
          "binding": "GOOGLE_CONTACTS",
          "service": "osteo-contacts-sync",
          "entrypoint": "GoogleContactsService",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "osteo-backoffice",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ORIGIN": "https://backoffice.osteopathie-animale-bordeaux.fr",
        "ACCESS_TEAM_DOMAIN": "configure-before-use",
        "ACCESS_AUD": "configure-before-use",
      },
    },
  },
}
