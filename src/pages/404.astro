---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buttonVariants } from '../components/ui/button';
---

<BaseLayout
  title="404 : Page non trouvée | Agathe Lescout"
  description="La page que vous recherchez n'existe pas."
  noindex
>
  <main id="root" class="site-container py-28 text-center">
    <p class="eyebrow">Page non trouvée</p>
    <h1 class="mt-5 text-8xl">404</h1>
    <p class="mt-5 text-muted-foreground">
      Désolé, cette page est introuvable.
    </p>
    <a href="/" class={buttonVariants({ className: 'mt-9' })}
      >Retour à l'accueil</a
    >
  </main>
</BaseLayout>
