---
import { Image } from 'astro:assets';
import { ArrowUpRightIcon } from '@phosphor-icons/react';
import SectionHeading from './SectionHeading';
import { animalPages } from '../../lib/content/animal-pages';
---

<section id="animaux" class="section-space animals-section site-container">
  <div class="section-topline">
    <SectionHeading
      eyebrow="Petits et grands compagnons"
      title="À chacun son accompagnement."
    />
    <p class="animals-intro">Des besoins différents.<br />La même attention.</p>
  </div>
  <div class="animal-grid">
    {animalPages.map((animal) => <a
      href={`/animaux/${animal.slug}/`}
      class="animal-card"
      data-animal={animal.slug}
    >
      <div class="animal-card-image" data-reveal="image">
        <Image
          src={animal.image}
          alt={animal.label}
          widths={[320, 640, 960]}
          sizes="(min-width: 1408px) 302px, (min-width: 1101px) calc(25vw - 50px), (min-width: 701px) calc(50vw - 44px), calc(50vw - 28px)"
          width={640}
          format="webp"
          loading="lazy"
          data-testid="responsive-content-image"
        />
      </div>
      <div class="animal-card-content">
        <div>
          <h3>{animal.label}</h3>
          <p>{animal.cardDescription}</p>
        </div>
        <ArrowUpRightIcon size={22} aria-hidden="true" />
      </div>
    </a>)}
  </div>
  <p class="animal-cow">
    Vous avez des animaux d’élevage ?
    <a href="/#contact"
      >Échangeons sur leurs besoins
      <ArrowUpRightIcon size={16} aria-hidden="true"
    /></a>
  </p>
</section>
