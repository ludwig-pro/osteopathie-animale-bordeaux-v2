---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  siteUrl?: string;
  canonicalUrl?: string;
  schema?: unknown;
}

const {
  title,
  description = "L'Ostéopathe animalier Agathe Lescout, intervenant sur Bordeaux et Gironde!",
  siteUrl = 'https://www.osteopathie-animale-bordeaux.fr',
  canonicalUrl = siteUrl,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#c0823f" />
    <link rel="icon" type="image/png" href="/icon.png" />
    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}

    <script is:inline>
      // Available before any asynchronously loaded container or UI module.
      window.__cookieConsentManaged = true;
      window.siteConsent = {
        googleAnalytics: false,
        googleAds: false,
        posthog: false,
      };
      window.dataLayer = window.dataLayer || [];
    </script>
    <script is:inline>
      (function (w, d) {
        var RECOVERY_KEY_PREFIX = 'module-script-recovery:';
        var HISTORY_STATE_KEY = '__moduleScriptRecoveryAttempted';
        var KNOWN_MODULE_SCRIPT_ERRORS = [
          'Importing a module script failed.',
          'Failed to fetch dynamically imported module',
          'error loading dynamically imported module',
        ];

        var hasRecoveryAttempted = false;

        var hasHistoryRecoveryAttempted = function () {
          try {
            return w.history.state[HISTORY_STATE_KEY] === true;
          } catch (_error) {
            return false;
          }
        };

        var markHistoryRecoveryAttempted = function () {
          try {
            var currentState = w.history.state;
            var nextState =
              currentState !== null && typeof currentState === 'object'
                ? Object.assign({}, currentState)
                : {};

            nextState[HISTORY_STATE_KEY] = true;
            w.history.replaceState(nextState, '', w.location.href);
            return true;
          } catch (_error) {
            return false;
          }
        };

        var getRecoveryKey = function (event) {
          var target = event && event.target;
          if (target instanceof HTMLScriptElement && target.src) {
            return RECOVERY_KEY_PREFIX + target.src;
          }

          var firstAstroModuleScript = Array.prototype.find.call(
            d.scripts,
            function (script) {
              return (
                script instanceof HTMLScriptElement &&
                script.type === 'module' &&
                script.src.indexOf('/_astro/') !== -1
              );
            }
          );

          if (
            firstAstroModuleScript instanceof HTMLScriptElement &&
            firstAstroModuleScript.src
          ) {
            return RECOVERY_KEY_PREFIX + firstAstroModuleScript.src;
          }

          return RECOVERY_KEY_PREFIX + w.location.pathname;
        };

        var extractErrorMessage = function (value) {
          if (!value) {
            return '';
          }

          if (typeof value === 'string') {
            return value;
          }

          if (typeof value.message === 'string') {
            return value.message;
          }

          if (value.reason && typeof value.reason.message === 'string') {
            return value.reason.message;
          }

          if (typeof value.toString === 'function') {
            return value.toString();
          }

          return '';
        };

        var isKnownModuleScriptError = function (value) {
          var message = extractErrorMessage(value);
          return KNOWN_MODULE_SCRIPT_ERRORS.some(function (fragment) {
            return message.indexOf(fragment) !== -1;
          });
        };

        var reloadOnce = function (event) {
          if (hasRecoveryAttempted) {
            return;
          }

          var storageKey = getRecoveryKey(event);

          try {
            if (w.sessionStorage.getItem(storageKey) === '1') {
              return;
            }

            w.sessionStorage.setItem(storageKey, '1');
          } catch (_error) {
            if (hasHistoryRecoveryAttempted()) {
              return;
            }

            if (!markHistoryRecoveryAttempted()) {
              hasRecoveryAttempted = true;
              return;
            }
          }

          hasRecoveryAttempted = true;
          w.location.reload();
        };

        w.addEventListener(
          'error',
          function (event) {
            var target = event.target;

            if (
              target instanceof HTMLScriptElement &&
              target.type === 'module' &&
              target.src
            ) {
              reloadOnce(event);
              return;
            }

            if (
              isKnownModuleScriptError(event.error) ||
              isKnownModuleScriptError(event.message)
            ) {
              reloadOnce(event);
            }
          },
          true
        );

        w.addEventListener('unhandledrejection', function (event) {
          if (isKnownModuleScriptError(event.reason)) {
            reloadOnce(event);
          }
        });
      })(window, document);
    </script>
    <script>
      import '../lib/consent';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
