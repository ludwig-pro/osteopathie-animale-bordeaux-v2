---
import Pricing from '../../components/landing-page/pricing/Pricing';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import chienetchat from '../../images/chienetchat.jpeg';
import furet from '../../images/furet.jpeg';
import cheval from '../../images/sectionCheval.jpg';
import forfait from '../../images/forfaitmensuel.jpeg';

const widths = [320, 640, 800] as const;
const sizes =
  '(min-width: 1352px) 295px, (min-width: 961px) 23vw, (min-width: 641px) 44vw, calc(50vw - 27px)';

const [chienetchatImg, furetImg, chevalImg, forfaitImg] = await Promise.all([
  buildResponsiveImage(chienetchat, widths, sizes),
  buildResponsiveImage(furet, widths, sizes),
  buildResponsiveImage(cheval, widths, sizes),
  buildResponsiveImage(forfait, widths, sizes),
]);
---

<Pricing
  client:visible={{ rootMargin: '300px' }}
  id={Astro.props['id']}
  chienetchatImg={chienetchatImg}
  furetImg={furetImg}
  chevalImg={chevalImg}
  forfaitImg={forfaitImg}
/>
