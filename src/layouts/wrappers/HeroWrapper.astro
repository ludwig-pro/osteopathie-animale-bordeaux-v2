---
import { getImage } from 'astro:assets';
import Hero from '../../components/landing-page/hero/Hero';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import care from '../../images/yougncat.jpeg';
import agathe from '../../images/agathe.jpg';
const careImage = await buildResponsiveImage(
  care,
  [480, 800, 1200],
  '(min-width: 1408px) 560px, (min-width: 901px) calc(45vw - 66px), calc(100vw - 64px)'
);
const portrait = await getImage({ src: agathe, width: 112, format: 'webp' });
---

<Hero client:load careImage={careImage} portrait={portrait.src} />
