---
import About from '../../components/landing-page/about/About';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import agathe from '../../images/agathe.jpg';

const agatheImg = await buildResponsiveImage(
  agathe,
  [320, 640, 960],
  '(min-width: 1408px) 600px, (min-width: 1101px) calc(50vw - 104px), (min-width: 901px) calc(50vw - 52px), (min-width: 701px) calc(100vw - 64px), calc(100vw - 40px)'
);
---

<About agatheImg={agatheImg} />
