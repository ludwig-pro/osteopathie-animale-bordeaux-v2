---
import Osteopathy from '../../components/landing-page/osteopathy/Osteopathy';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import bulldog from '../../images/bulldog.jpeg';

const bulldogImg = await buildResponsiveImage(
  bulldog,
  [560, 768, 1200],
  '(min-width: 1416px) 606px, (min-width: 1101px) calc(50vw - 102px), (min-width: 801px) calc(50vw - 56px), calc(100vw - 40px)'
);
---

<Osteopathy id={Astro.props['id']} bulldogImg={bulldogImg} />
