---
import ConsultationProcess from '../../components/landing-page/consultation/ConsultationProcess';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import youngcat from '../../images/yougncat.jpeg';
import correction from '../../images/correction.jpg';

const widths = [480, 768, 1200] as const;
const sizes =
  '(min-width: 1280px) 624px, (min-width: 1024px) calc(50vw - 1rem), (min-width: 640px) 560px, (min-width: 576px) 576px, 100vw';

const [youngcatImg, correctionImg] = await Promise.all([
  buildResponsiveImage(youngcat, widths, sizes),
  buildResponsiveImage(correction, widths, sizes),
]);
---

<ConsultationProcess youngcatImg={youngcatImg} correctionImg={correctionImg} />
