---
import AnimalSection from '../../components/landing-page/animals/AnimalSection';
import { buildResponsiveImage } from '../../lib/responsiveImage';
import sectionChien from '../../images/sectionChien.jpg';
import sectionChat from '../../images/sectionChat.jpg';
import sectionCheval from '../../images/sectionCheval.jpg';
import sectionLapin from '../../images/sectionLapin.jpg';
import sectionVache from '../../images/sectionVache.jpg';

const widths = [480, 768, 1280] as const;
const sizes =
  '(min-width: 1280px) 592px, (min-width: 1024px) calc(50vw - 3rem), (min-width: 768px) 452px, (min-width: 640px) calc(50vw + 8.25rem), calc(100vw + 10rem)';

const [
  sectionChienImg,
  sectionChatImg,
  sectionChevalImg,
  sectionLapinImg,
  sectionVacheImg,
] = await Promise.all([
  buildResponsiveImage(sectionChien, widths, sizes),
  buildResponsiveImage(sectionChat, widths, sizes),
  buildResponsiveImage(sectionCheval, widths, sizes),
  buildResponsiveImage(sectionLapin, widths, sizes),
  buildResponsiveImage(sectionVache, widths, sizes),
]);

const optimizedImages = {
  sectionChien: sectionChienImg,
  sectionChat: sectionChatImg,
  sectionCheval: sectionChevalImg,
  sectionLapin: sectionLapinImg,
  sectionVache: sectionVacheImg,
};
---

<AnimalSection client:load optimizedImages={optimizedImages} />
